# Scoring. Without this, pnpm dev still works: the page falls back to the committed
# snapshot in data/snapshot.json.
TYPESAFE_API_KEY=

# Article extraction. Optional. Without it, article fetching falls back to plain fetch
# and strip, which covers most pages but loses the ones that need a real browser.
FIRECRAWL_API_KEY=

# Protects /api/cron/score. The route refuses to run if this is unset rather than
# falling open, since an unprotected endpoint there is a free quota drain.
CRON_SECRET=

# Set automatically when a Vercel Blob store is connected to the project. Only needed
# to write a refresh; reads fall back to the committed snapshot without it.
BLOB_READ_WRITE_TOKEN=
